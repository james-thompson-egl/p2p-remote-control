{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P2P Remote Viewer",
  "version": "0.1.0",
  "identifier": "com.p2premote.viewer",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "../frontend",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "P2P Remote Control",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
